# NexusDock 仓库 Compose 模板的 env 示例。README 快速开始和已有自定义 Compose 无需使用本文件。
# 使用仓库模板时可执行 cp .env.example .env，再按实际站点调整下面的值。

# 宿主机数据目录（挂载到容器 /var/lib/nexus），生产建议绝对路径。
NEXUS_DATA_DIR=./nexus-data

# 共享 Recall 仓库目录（挂载到容器 /recall），生产建议绝对路径。
RECALL_REPO_DIR=./recall

# 对外 HTTPS Origin（本机反向代理之后对公网暴露的地址）；留空表示仅本机回环访问。
NEXUS_PUBLIC_URL=

# 允许提供可信 X-Forwarded-* 的代理地址/网段。留空时默认信任 loopback；
# 在官方 Linux 容器中，仅检测到唯一候选时才自动追加当前容器的 RFC1918 bridge 网关，
# 因此“宿主机 Nginx/Caddy -> 127.0.0.1:18777”无需手填 Docker 网段。
# 复杂代理链可显式填写精确 IP/CIDR；一旦填写会完全覆盖自动默认值。
NEXUS_TRUSTED_PROXIES=

# 宿主机监听地址与端口（容器内固定 18777）。默认只绑定回环，由本机反向代理对外；
# 若必须改为 0.0.0.0（例如反代位于同一 Docker 网络），请同时显式设置精确的
# NEXUS_TRUSTED_PROXIES，并用防火墙限制来源，不要继续依赖自动网关信任。
NEXUS_HTTP_BIND=127.0.0.1
NEXUS_HTTP_PORT=18777

# 使用仓库模板时可固定镜像标签。留空回退 nexusdock:local（本地构建场景）。
# 对稳定性要求较高的部署建议固定版本或 sha-<短SHA> 标签；README 快速开始使用 latest 便于直接上手。
NEXUS_IMAGE=

# 本地 docker compose build 注入的版本信息（缺省与 Dockerfile/Makefile 一致）；
# 生产直接消费发布镜像，不参与构建，无需设置。
#NEXUS_VERSION=dev
#NEXUS_REVISION=unknown
#NEXUS_SOURCE=unknown
